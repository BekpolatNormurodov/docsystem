generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextIndex"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// An app user. `role` splits ADMIN (full control + oversight) from YURIST (a
// lawyer who only sees/works the pipeline steps an admin has granted). Kept the
// model name `Admin` so existing rows/login/seed keep working; the row now
// carries a role. YURIST rows list their granted step keys in `steps`
// (e.g. ["talabnoma","invoice"] — see STEP_KEYS in src/lib/access.ts).
model Admin {
  id           Int        @id @default(autoincrement())
  username     String     @unique
  passwordHash String
  role         String     @default("ADMIN") // ADMIN | YURIST
  fullName     String?
  steps        Json? // YURIST only: array of allowed step keys
  active       Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt @default(now())
  auditLogs    AuditLog[]
}

// Who did what, when. Every pipeline mutation writes one row here so a katta ish
// (stage advance, talabnoma send, ariza/invoice/packet build, court/MIB submit,
// import, user change) is traceable to a user id. `username`/`role` are
// denormalized so the trail survives a user being deleted. See src/lib/audit.ts.
model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int?
  user      Admin?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  username  String // denormalized signer identity (survives user deletion)
  role      String?
  action    String // STAGE_ADVANCE | TALABNOMA_SEND | ARIZA_GEN | INVOICE_GEN | COURT_SUBMIT | MIB | IMPORT | USER_* | LOGIN | LOGOUT ...
  target    String? // free-form subject, e.g. "case:123", "firm:12842", "user:mahmud"
  detail    Json? // action-specific payload (counts, ids, before/after)
  ip        String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model Firm {
  id          Int      @id @default(autoincrement())
  code        String   @unique // branch code, e.g. "12842"
  shortName   String // "BRIGHT FUTURE FINANCING"
  legalName   String? // full legal Latin name for the ariza
  address     String?
  region      String? // billing «Viloyat» dropdown ko'rinadigan matni, masalan "Тошкент шаҳар"
  district    String? // billing «Tuman» dropdown matni, masalan "Олмазор тумани"
  addressLine String? // ko'cha/uy, masalan "Gurushariq MFY, Sag'bon kochasi 30-berk 7/1"
  bankAccount String? // X/R
  mfo         String?
  stir        String?
  postIndex   String?
  phone       String?
  invoices    InvoiceRecord[]
  arizaCases  ArizaCase[]
  documents   FirmDocument[]
  batches     InvoiceBatch[]
  restBatches InvoiceRestBatch[]
  updatedAt   DateTime @updatedAt
}

model Snapshot {
  id             Int      @id @default(autoincrement())
  reportDate     DateTime @unique @db.Date
  sourceFileName String
  status         String   @default("IMPORTING") // IMPORTING | READY | FAILED
  rowCount       Int      @default(0)
  processedRows  Int      @default(0)
  totalDebt      Decimal  @default(0) @db.Decimal(30, 2)
  importedAt     DateTime @default(now())
  excludedCount  Int      @default(0)
  loans          Loan[]
}

model Loan {
  id                   Int      @id @default(autoincrement())
  snapshotId           Int
  snapshot             Snapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  pinfl                String?
  passportSn           String?
  clientName           String?
  phone                String?
  postAddress          String?  @db.Text
  postAddressUz        String?  @db.Text // clean Uzbek Latin address (region + district + tail)
  regionName           String?
  branchCode           String?
  ldId                 String?
  account              String?
  summKr               Decimal? @db.Decimal(20, 2)
  rate                 Decimal? @db.Decimal(6, 2)
  dateToCr             DateTime? @db.Date
  dateClose            DateTime? @db.Date
  klassName            String?
  statusName           String?
  termType             String?
  debtPrincipal        Decimal  @default(0) @db.Decimal(20, 2) // summ_ost_ze
  debtTermInterest     Decimal  @default(0) @db.Decimal(20, 2) // sumproc_eqv
  debtOverduePrincipal Decimal  @default(0) @db.Decimal(20, 2) // summ_ostpr_ze
  debtOverdueInterest  Decimal  @default(0) @db.Decimal(20, 2) // sumnachpr_eqv
  totalDebt            Decimal  @default(0) @db.Decimal(20, 2)
  raw                  Json     // the complete sheet row, header->value (full client detail)
  excluded             Boolean  @default(false)

  @@index([snapshotId])
  @@index([snapshotId, pinfl])
  @@index([snapshotId, branchCode])
  @@index([snapshotId, clientName])
  @@index([snapshotId, totalDebt])
  @@index([snapshotId, excluded])
  // Cross-snapshot lookups: the "Hamma sana" MAX(snapshotId) join and prefix search on id fields.
  // (pinfl, snapshotId) lets the latest-per-client derived table resolve from the index alone.
  @@index([pinfl, snapshotId])
  @@index([ldId])
  @@index([passportSn])
  // Fast name search: MATCH(clientName) AGAINST(… IN BOOLEAN MODE) — ~30ms vs ~8s for %substring%.
  @@fulltext([clientName])
  // Covering index for the Mijozlar per-client groupBy (pinfl, clientName, SUM totalDebt): lets the
  // aggregate run index-only, WITHOUT reading each row's fat `raw` JSON blob — ~11s → ~0.9s.
  @@index([snapshotId, pinfl, clientName, totalDebt], map: "Loan_cover_mijoz")
  // Covering index for the Hujjatlar [date] page: the per-client groupBy (pinfl, clientName, SUM
  // totalDebt) AND the COUNT(DISTINCT pinfl) card total, both filtered by `excluded` (Barchasi vs Sud
  // roʻyxati). Index-only, no fat `raw` read — ~15s → ~1s.
  @@index([snapshotId, excluded, pinfl, clientName, totalDebt], map: "Loan_cover_excluded")
  // Covering index for the [date] firm chips groupBy(branchCode) WHERE snapshotId AND excluded —
  // ~22s → ~0.15s.
  @@index([snapshotId, excluded, branchCode], map: "Loan_cover_branch")
  // Covering index for the Portfel /s/[date] "Firmalar boʻyicha qarz" chart:
  // groupBy(branchCode) SUM(totalDebt) WHERE snapshotId. Without it that sum
  // full-scans 159k rows off-index (~34s); with it the scan is index-only (~ms).
  // NOTE: needs `npm run db:push` to take effect.
  @@index([snapshotId, branchCode, totalDebt], map: "Loan_cover_firm_debt")
}

model Setting {
  key   String @id
  value String @db.Text
}

model Job {
  id         Int      @id @default(autoincrement())
  type       String   // IMPORT | EXPORT
  status     String   @default("PENDING") // PENDING | RUNNING | DONE | FAILED
  progress   Int      @default(0)
  total      Int      @default(0)
  message    String?  @db.Text
  resultPath String?
  params     Json?
  snapshotId Int?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// «Talabnoma shakllantirish» — mustaqil bo'lim (Boshqaruv step'laridan alohida). Operator 2 ta
// Excel yuklaydi (20.08 talabnoma-manba + портфель), ular DISK'da saqlanadi va bu yozuv ularning
// PATH'ini ushlab turadi — history shu yerdan ochib ko'radi. Snapshot/Loan konveyeridan mustaqil.
model TalabnomaFormBatch {
  id                Int                 @id @default(autoincrement())
  createdAt         DateTime            @default(now())
  createdBy         String? // yaratgan admin username
  label             String? // ixtiyoriy nom (masalan sana)
  status            String              @default("PARSING") // PARSING | READY | FAILED
  message           String?             @db.Text
  sourceFileName    String // 20.08 fayl asl nomi
  sourcePath        String // diskdagi to'liq yo'l
  portfolioFileName String // портфель asl nomi
  portfolioPath     String
  candidatesPath    String? // parse natijasi (candidates.json) yo'li
  processedRows     Int                 @default(0) // портфель oqimidan o'qilgan qatorlar (progress %)
  totalRows         Int                 @default(0) // портфель taxminiy qator soni (progress mahraji)
  candidateCount    Int                 @default(0) // List1 dagi jami shaxs
  qualifiedCount    Int                 @default(0) // standart 2mln chegaradan o'tganlar
  summary           Json? // firma bo'yicha sonlar, tayyor/tayyor emas, taqsimot
  runs              TalabnomaFormRun[]
}

// Har bir generatsiya/yuborish amali — history uchun. resultPath diskdagi xlsx/zip ni ko'rsatadi.
model TalabnomaFormRun {
  id              Int                @id @default(autoincrement())
  batchId         Int
  batch           TalabnomaFormBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  createdAt       DateTime           @default(now())
  createdBy       String?
  kind            String // REYESTR | LETTERS | HIPPO
  firmCode        String?
  firmName        String?
  filters         Json? // { thresholdTotal, perFirmMin, includeUnready }
  rowCount        Int                @default(0)
  personCount     Int                @default(0)
  status          String             @default("PENDING") // PENDING | RUNNING | DONE | FAILED
  message         String?            @db.Text
  resultPath      String?
  hippoRegistryId String?

  @@index([batchId])
}

// «MIB hisoboti» — mustaqil bo'lim. HISOBOT excel yuklanadi, «Holat» ustuni bo'yicha (masalan
// «MIBda») filtrlanadi, GO bosilsa har ~1 daqiqada ketma-ket mib.uz dan tekshiradi (captcha OCR +
// SMS-OTP), natijalarni DB ga yozadi. Statelar yo'qolmaydi (resumable), sessiya uzilmaydi.
model MibReport {
  id             Int         @id @default(autoincrement())
  createdAt      DateTime    @default(now())
  createdBy      String?
  label          String?
  sourceFileName String
  sourcePath     String
  statusFilter   String? // qaysi «Holat» qiymati bo'yicha filtrlangan (masalan «MIBda»)
  total          Int         @default(0)
  autoRun        Boolean     @default(false) // GO faol (avtomator ishlayapti)
  runJobId       Int? // joriy MIB_RUN job
  clients        MibClient[]
}

model MibClient {
  id           Int       @id @default(autoincrement())
  reportId     Int
  report       MibReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  rowNo        Int?
  pinfl        String
  fio          String?
  phone        String? // Excel «Тел» (ma'lumot uchun)
  firm         String? // MKO (BRIGHT/URBAN/COMMUNITY...)
  ishRaqami    String? // Excel «Ish raqami»
  holat        String? // Excel «Holat» (MIBda...)
  region       String?
  address      String?  @db.Text
  totalDebtSrc String? // Excel «Jami karzdorlik»
  // avtomatlashtirish holati
  status      String    @default("PENDING") // PENDING | RUNNING | DONE | CLEAN | FAILED
  attempts    Int       @default(0)
  fio2        String? // mib.uz dan olingan F.I.O
  totalDebt   String? // mib.uz jami qarz
  currentDebt String?
  error       String?   @db.Text
  checkedAt   DateTime?
  cases       MibCase[]

  @@index([reportId])
  @@index([pinfl])
  @@index([status])
}

model MibCase {
  id            Int       @id @default(autoincrement())
  clientId      Int
  client        MibClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  workNumber    String // «Ijro ishi raqami»
  monitoringUrl String?   @db.Text
  // Step 19 chuqur detal (SMS-OTP dan keyin to'ladi)
  personFullName     String?
  creditor           String? @db.Text
  firmName           String? // companies.json dan aniqlangan
  firmInn            String?
  isTargetFirm       Boolean @default(false)
  executorName       String?
  executorPhone      String?
  executorDept       String?
  courtOrgan         String? @db.Text
  courtDocType       String?
  courtDocNumber     String?
  courtDocDate       String?
  courtEffectiveDate String?
  caseSubject        String? @db.Text
  mibReceivedDate    String?
  mibInitiatedDate   String?
  totalAmount        String?
  mainDebt           String?
  executionFee       String?
  fine               String?
  remainingDebt      String?
  bankName           String? @db.Text
  bankMfo            String?
  bankAccount        String?
  decisions          Json?
  detailFetchedAt    DateTime?
  error              String?   @db.Text

  @@index([clientId])
  @@index([workNumber])
}

// mib-webhook orqali kelgan SMS kodlar (mobil forwarder POST qiladi). Avtomator shu jadvaldan
// so'rov vaqtidan keyin kelgan yangi kodni oladi (consumed=true qiladi).
model MibSms {
  id        Int      @id @default(autoincrement())
  code      String
  raw       String?  @db.Text
  source    String?
  createdAt DateTime @default(now())
  consumed  Boolean  @default(false)

  @@index([createdAt])
  @@index([consumed])
}

model InvoiceRecord {
  id          Int      @id @default(autoincrement())
  invoiceNo   String   @unique
  firmId      Int
  firm        Firm     @relation(fields: [firmId], references: [id])
  paymentType String
  amount      Decimal  @db.Decimal(20, 2)
  courtType   String
  courtRegion String
  court       String
  pdfPath     String?
  status      String   @default("CREATED") // CREATED | FAILED
  createdAt   DateTime @default(now())

  // Qaysi REST paketda yaratilganini bog'laydi (ixtiyoriy — eski yozuvlar null).
  restBatchId String?
  restBatch   InvoiceRestBatch? @relation(fields: [restBatchId], references: [id])

  // Qaysi konveyer case'iga (mijoz: pinfl+firma) tegishli — BOJ qadamida yaratilganda.
  // Firma bo'yicha ommaviy /invoyslar paketi uchun null.
  caseId      Int?
  case        ArizaCase? @relation(fields: [caseId], references: [id])

  @@index([firmId])
  @@index([restBatchId])
  @@index([caseId])
}

// «Firma uchun N ta kvitansiya avtomat yarat» REST paketining bitta ishga tushishi.
// Jarayon fonda ishlaydi; bu yozuv progress + natijani bazada saqlaydi (server
// qayta ishga tushsa ham tarix/ZIP yo'qolmaydi).
model InvoiceRestBatch {
  id        String          @id
  firmId    Int
  firm      Firm            @relation(fields: [firmId], references: [id])
  total     Int
  ok        Int             @default(0)
  failed    Int             @default(0)
  phase     String          @default("RUNNING") // RUNNING | PAUSING | DONE
  records   InvoiceRecord[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([firmId])
}

enum ExtProvider {
  HIPPO
  CABINET
}

enum ExtSessionStatus {
  ACTIVE // token valid, usable for data pulls
  EXPIRED // token past expiry / rejected — needs E-IMZO re-auth
  REVOKED // manually invalidated
}

// A persisted session/token for an external e-gov integration (xat.hippo.uz and
// cabinet.sud.uz/Adolat). Keyed by (provider, account) so each firm/key has its
// own. Lets the system keep pulling data with the stored token until it expires;
// when EXPIRED the UI prompts the user to re-confirm via E-IMZO. See
// src/lib/session-store.ts.
model ExternalSession {
  id           Int              @id @default(autoincrement())
  provider     ExtProvider
  account      String // key/org identity, e.g. STIR or "BRIGHT" or key CN
  accessToken  String           @db.Text // hippo bearer JWT / cabinet X-AUTH-TOKEN
  refreshToken String?          @db.Text
  tokenId      String? // cabinet/oneid token_id
  expiresAt    DateTime? // known for hippo (7d); null => verify via API
  status       ExtSessionStatus @default(ACTIVE)
  keyCn        String?
  org          String?
  meta         Json? // entity_id, pin, username, key info, etc.
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  lastUsedAt   DateTime         @default(now())

  @@unique([provider, account])
  @@index([provider, status])
}

enum FeeInvoiceStatus {
  NOT_PAID // invoice generated, awaiting payment
  IN_PROCESS // payment initiated / being confirmed ("jarayonida")
  PAID // confirmed paid — ready to attach to the claim
}

// A cabinet.sud.uz state-fee (davlat boji) invoice tracked through its payment
// lifecycle in our DB, tied to a draft claim. status flows NOT_PAID -> IN_PROCESS
// -> PAID; the claim can only be submitted once its fee invoice is PAID. See
// src/lib/cabinet/invoice.ts.
model CourtFeeInvoice {
  id            Int              @id @default(autoincrement())
  account       String // org STIR that owns the session/claim, e.g. 311976765
  draftId       String? // cabinet draft/case id this fee belongs to
  receiptNumber String? // davlat-boji receipt/invoice number (e.g. 262196086404)
  instance      String? // FIRST | APPEAL | CASSATION
  claimType     String? // CIVIL | ECONOMIC | ADMINISTRATIVE
  claimKind     String? // SUIT | MATERIAL
  claimAmount   Decimal?         @db.Decimal(20, 2) // da'vo summasi
  amountPost    Decimal?         @db.Decimal(20, 2) // POST fee
  amountVcc     Decimal?         @db.Decimal(20, 2) // VCC fee
  amountState   Decimal?         @db.Decimal(20, 2) // STATE duty
  amountTotal   Decimal?         @db.Decimal(20, 2)
  status        FeeInvoiceStatus @default(NOT_PAID)
  meta          Json? // raw calc/generate/find responses
  createdAt     DateTime         @default(now())
  paidAt        DateTime?
  updatedAt     DateTime         @updatedAt

  @@unique([account, receiptNumber])
  @@index([account, status])
  @@index([draftId])
}

// ===== Konveyer pipeline (talabnoma -> sud -> MIB) =====

enum CaseStage {
  IMPORTED
  TALABNOMA_SENT
  ARIZA_GENERATED
  PRINTED
  CHAMBER_SENT
  CHAMBER_RETURNED
  SIGNED_SCANNED
  INVOICE_CREATED
  INVOICE_PAID
  COURT_SUBMITTED
  COURT_ACCEPTED
  COURT_RETURNED
  MIB_SUBMITTED
  CLOSED
}

// One debtor (pinfl) x firm x cycle moving through the pipeline. Counts on the
// Konveyer dashboard aggregate ArizaCase.stage per firm and overall.
model ArizaCase {
  id            Int       @id @default(autoincrement())
  firmId        Int
  firm          Firm      @relation(fields: [firmId], references: [id])
  snapshotId    Int?
  pinfl         String?
  clientName    String?
  kod           String? // client code from the source Excel, e.g. 60123092
  stage         CaseStage @default(IMPORTED)
  stageEnteredAt DateTime @default(now())
  // Parallel track: talabnoma (hippo) runs independently of the ariza→palata
  // stage track; both converge at Sud. Set when the talabnoma is sent.
  talabnomaAt   DateTime?
  slaDays       Int       @default(3) // working-day budget for the current stage
  dueAt         DateTime? // deadline for the current stage; past due => "osilgan"
  invoiceNo     String? // davlat-boji invoice number
  receiptNumber String? // kvitansiya raqami (262...)
  batchId       Int?
  batch         InvoiceBatch? @relation(fields: [batchId], references: [id])
  courtCaseId   String? // cabinet.sud.uz draft/case id
  mibRef        String? // MIB ijro reference
  totalDebt     Decimal   @default(0) @db.Decimal(20, 2)
  meta          Json?
  documents     CaseDocument[]
  invoiceRecords InvoiceRecord[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // One case per (snapshot, person, firm) — DB-enforced idempotency for
  // syncCasesFromSnapshot (pairs with createMany skipDuplicates). NULL pinfls are
  // distinct in MySQL, so identity-less rows are unaffected.
  // NOTE: needs `npm run db:push` to take effect (dedupe any existing rows first).
  @@unique([snapshotId, pinfl, firmId])
  @@index([firmId, stage])
  @@index([snapshotId])
  @@index([stage, dueAt])
  @@index([pinfl])
  @@index([batchId])
}

enum FirmDocKind {
  GUVOHNOMA
  ISHONCHNOMA
  SHARTNOMA
  OFERTA
  BOSHQA
}

// Per-firm static PDF library attached into each client's court packet.
model FirmDocument {
  id        Int         @id @default(autoincrement())
  firmId    Int
  firm      Firm        @relation(fields: [firmId], references: [id])
  kind      FirmDocKind
  label     String?
  filePath  String
  sortOrder Int         @default(0)
  createdAt DateTime    @default(now())

  @@index([firmId, kind])
}

enum BatchStatus {
  DRAFT
  GENERATING
  DONE
  FAILED
}

// A run of "generate N boji invoices for this firm" that yields a buxgalteriya
// farmoyishi (numbered postal-fee directive) and links each invoice to a case.
model InvoiceBatch {
  id             Int         @id @default(autoincrement())
  firmId         Int
  firm           Firm        @relation(fields: [firmId], references: [id])
  court          String? // e.g. "Uchtepa tumanlararo sudi"
  requestedCount Int
  createdCount   Int         @default(0)
  status         BatchStatus @default(DRAFT)
  farmoyishPath  String?
  cases          ArizaCase[]
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([firmId, status])
}

// A real court/letter status for a portfolio client, pulled from cabinet.sud.uz
// (Adolat) or xat.hippo and matched back to our client by name (pinfl). One row
// per (source, external case/letter ref). Powers the per-firm real-status board.
model ClientCaseStatus {
  id          Int       @id @default(autoincrement())
  branchCode  String // firm code, e.g. 12842
  pinfl       String? // matched portfolio client PINFL (null if unmatched)
  clientName  String
  source      String // CABINET | HIPPO
  category    String? // civil | economic | administrative | conflict | talabnoma
  caseNumber  String? // cabinet case_number
  claimId     String? // cabinet claim_id / case_id
  claimKind   String? // DECREE | SUIT | MATERIAL
  instance    String?
  status      String // CREATED|PENDING|IN_PROCESS|DECIDED|FINISHED|DECLINED|...
  statusLabel String?
  caseResult  String?
  courtId     String?
  hearingDate DateTime?
  registryDt  DateTime?
  matchedBy   String // NAME | CLAIM_ID | CUSTOM_ID | PINFL | UNMATCHED
  docPath     String?
  detail      Json? // full get-one-case-by-id payload
  defAddress  String? // defendant address (from detail)
  defPassport String? // defendant passport serial+number (from detail)
  judge       String? // chairman/responsible judge (from detail)
  snapshotId  Int?
  updatedAt   DateTime  @updatedAt

  @@unique([source, caseNumber])
  @@index([branchCode, source, status])
  @@index([pinfl])
  // courtStatusBoard groupBy filters by (snapshotId, branchCode); the aggregate (no firm)
  // path filters snapshotId alone, which had no index. Lets that filtered aggregate use an index.
  @@index([snapshotId, branchCode])
}

// A file uploaded/attached to a case (e.g. the signed scanned ariza, a receipt).
model CaseDocument {
  id         Int       @id @default(autoincrement())
  caseId     Int
  case       ArizaCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  kind       String // TALABNOMA | ARIZA | SIGNED_ARIZA | INVOICE | GUVOHNOMA | ISHONCHNOMA | SHARTNOMA | OFERTA | BOSHQA
  fileName   String
  filePath   String
  size       Int       @default(0)
  uploadedAt DateTime  @default(now())

  @@index([caseId])
}

# ─────────────────────────────────────────────────────────────────────────────
#  docsystem — PRODUCTION configuration
#  Copy to `.env.production`, fill every REPLACE_ value, and keep it OFF git.
#  Generate strong secrets:   openssl rand -hex 32     (or run ./scripts/gen-secrets.sh)
# ─────────────────────────────────────────────────────────────────────────────

# ── MySQL ────────────────────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=REPLACE_with_random_alnum_root_password
MYSQL_DATABASE=docsystem
MYSQL_USER=docsystem
# IMPORTANT: keep this ALPHANUMERIC — it is embedded verbatim into the DATABASE_URL DSN, and characters
# like @ : / # would corrupt the URL.
MYSQL_PASSWORD=REPLACE_with_random_alnum_app_password

# ── App auth ─────────────────────────────────────────────────────────────────
# HS256 session-signing key. MUST be ≥32 chars and NOT a known placeholder, or the app refuses to sign
# sessions in production (see src/core/session.ts).
AUTH_SECRET=REPLACE_with_openssl_rand_hex_32
# Seed admin (created on first migrate; changing the password here does NOT update an existing admin —
# change it in the UI).
DOCSYSTEM_ADMIN_USERNAME=admin
DOCSYSTEM_ADMIN_PASSWORD=REPLACE_with_a_strong_admin_password

# ── Multi-domain cookie / TLS ────────────────────────────────────────────────
# Share one login session across yuristsystem.uz / dashboard.* / api.*  (leading dot = all subdomains).
COOKIE_DOMAIN=.yuristsystem.uz
# 1 = mark the session cookie Secure (send only over HTTPS). Set to 1 ONCE SSL is live; leave 0 during
# the very first HTTP-only bring-up or logins won't stick.
COOKIE_SECURE=1

# ── E-IMZO (optional, advanced) ──────────────────────────────────────────────
# Where E-IMZO signing happens:
#   server (DEFAULT) — the Node server talks to a LOCAL E-IMZO on 127.0.0.1:64443. This is the current
#                      Windows/desktop deployment; leave it as-is and nothing changes.
#   client           — the USER's BROWSER talks to THEIR local E-IMZO; the server only receives the
#                      finished PKCS7. Use this to run signing from a remote Linux server: each operator
#                      signs with the key on their own machine (E-IMZO desktop app must run locally).
EIMZO_MODE=server
# Client mode on a REAL domain needs a NIC-issued domain API-KEY ("domain,hash,domain,hash,..."). On
# localhost/dev the built-in allowlist covers it, so leave this empty for local development. NEXT_PUBLIC_*
# is exposed to the browser at build time (that is intentional — it is a domain allowlist, not a secret).
NEXT_PUBLIC_EIMZO_API_KEY=

# A Linux server has no local E-IMZO desktop app, so with EIMZO_MODE=server key signing / firm-connect /
# OneID+hippo login are unavailable server-side unless you bridge to a machine that runs E-IMZO and point
# this there. (With EIMZO_MODE=client this is not needed — the browser reaches the user's own E-IMZO.)
# Leave commented to keep the localhost default. See DEPLOYMENT.md → "E-IMZO on a server".
# EIMZO_WS_URL=wss://127.0.0.1:64443/service/cryptapi

# ── Backend worker (performance) ─────────────────────────────────────────────
# Parallel chromium renders per batch on the worker (backend). Scale with the server's CPU cores for
# faster packet/oferta/talabnoma generation — e.g. 12 on a big-CPU box (also raises peak chromium RAM;
# the worker already has a 1GB /dev/shm). Default 5.
WORKER_CONCURRENCY=5

# ── Domains / SSL — used by scripts (init-ssl, deploy), NOT read by the app ───────────────────────────
BASE_DOMAIN=yuristsystem.uz
CERTBOT_EMAIL=you@example.com
# 1 = Let's Encrypt STAGING certs (untrusted, but huge rate limits) for testing the SSL flow.
# 0 = real, trusted certs. Do a staging run first, then set 0 and re-run ./scripts/init-ssl.sh --force.
CERTBOT_STAGING=0

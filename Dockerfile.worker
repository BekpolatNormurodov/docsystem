# syntax=docker/dockerfile:1
#
# WORKER image — the ONLY container with chromium. It renders every court PDF (PACKET / OFERTA /
# TALABNOMA) from HTML templates via headless chromium, both the heavy bulk batches and the single-case
# jobs the web enqueues. Also runs the `migrate` one-shot (it has the prisma CLI + tsx). The Playwright
# base ships chromium + all system libraries at /ms-playwright, so no `playwright install` is needed.
FROM mcr.microsoft.com/playwright:v1.62.1-jammy

WORKDIR /app
ENV DATABASE_URL="mysql://build:build@localhost:3306/build"
ENV NODE_ENV=production
ENV JOB_MODE=worker

# Full install: the worker runs the TypeScript directly with tsx (a devDependency), and prisma db push
# (migrate) needs the prisma CLI (devDependency) — so keep the dev set.
COPY package.json package-lock.json ./
RUN npm ci --include=dev

COPY prisma ./prisma
RUN npx prisma generate

# The worker executes source directly (tsx) and reads the HTML->PDF templates from src/lib, so it needs
# the source tree + tsconfig. It does NOT need the Next build output.
COPY tsconfig.json ./
COPY src ./src
COPY data ./data
# Sudga yuborish dvigateli (src/lib/court-submit-job.ts) shu papkadan import qiladi. U yo'q
# bo'lsa worker STARTDA yiqiladi (MODULE_NOT_FOUND) — ya'ni PDF paket, oferta, talabnoma va
# billing avto-sinxronizatsiyasi ham to'xtaydi, chunki hammasi shu bitta jarayonda.
#
# ATAYIN faqat kutubxona modullari: papkadagi qo'lda ishga tushiriladigan skriptlar
# (test-dry-run.ts, send-one-live.ts, ...) worker'ga kerak emas va ulardan birida qattiq
# yozilgan sessiya tokeni bor — uni image qatlamiga bakib qo'ymaymiz.
COPY cabinet-api-skeleton/submitter.ts cabinet-api-skeleton/client.ts \
     cabinet-api-skeleton/builder.ts cabinet-api-skeleton/constants.ts \
     cabinet-api-skeleton/types.ts cabinet-api-skeleton/uploader.ts \
     ./cabinet-api-skeleton/

CMD ["npm", "run", "worker"]

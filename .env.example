DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/docsystem"
AUTH_SECRET="change-me-32-bytes-minimum-secret-string"
DOCSYSTEM_ADMIN_USERNAME="admin"
DOCSYSTEM_ADMIN_PASSWORD="admin"

# Where heavy document jobs (PACKET/OFERTA/TALABNOMA) run. Unset/"inline" = the web process runs them
# in-process (default). "worker" = the web only enqueues; a separate `npm run worker` process runs
# them. See WORKER.md.
# JOB_MODE="worker"

# E-IMZO signing location. "server" (default) = the Node server signs via a local E-IMZO desktop app
# (127.0.0.1:64443) — the current desktop flow, unchanged. "client" = the USER's browser signs with
# THEIR local E-IMZO and the server only receives the finished PKCS7 (dev-mode / remote-server ready).
# EIMZO_MODE="server"
# Client mode on a real domain needs a NIC-issued domain API-KEY ("domain,hash,..."). On localhost it
# is optional (built-in allowlist). Exposed to the browser at build time by design (not a secret).
# NEXT_PUBLIC_EIMZO_API_KEY=""
